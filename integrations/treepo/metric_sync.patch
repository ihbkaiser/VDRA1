+def _materialize_metric_tensors(metrics: Dict[str, torch.Tensor]) -> Dict[str, Any]:
+    """Copy scalar metrics to Python in one device synchronization."""
+    keys = list(metrics)
+    values = torch.stack([metrics[key].detach().reshape(()) for key in keys]).cpu().tolist()
+    return dict(zip(keys, values))
