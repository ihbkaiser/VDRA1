+    # ------------------------------------------------------------------ VDRA
+    def _vdra_cfg(self):
+        if getattr(self, "_vdra_config_obj", None) is None:
+            from vdra_core import VDRAConfig
+            raw = self.config.get("vdra", None)
+            try:
+                from omegaconf import OmegaConf
+                raw = OmegaConf.to_container(raw, resolve=True) if raw is not None else {}
+            except Exception:
+                raw = dict(raw or {})
+            raw = {k: v for k, v in (raw or {}).items() if k in VDRAConfig.__dataclass_fields__}
+            # Terminal pilots are not reused inside TreePO (they would bypass its
+            # finished-sample bookkeeping); they are charged as auxiliary cost.
+            raw["reuse_terminal_pilots"] = False
+            self._vdra_config_obj = VDRAConfig.from_dict(raw)
+        return self._vdra_config_obj
+
+    def _vdra_backend(self, eos_token_id):
+        if getattr(self, "_vdra_backend_obj", None) is None:
+            from vdra_core.backend import TokenBackend, from_vllm_llm
+            stop = eos_token_id if isinstance(eos_token_id, list) else [eos_token_id]
+            self._vdra_backend_obj = TokenBackend(
+                generate_fn=from_vllm_llm(self.inference_engine),
+                temperature=float(getattr(self.sampling_params, "temperature", 1.0)),
+                top_p=float(getattr(self.sampling_params, "top_p", 1.0)),
+                stop_token_ids=[t for t in stop if t is not None],
+                max_model_len=int(self._vdra_max_model_len),
+            )
+        return self._vdra_backend_obj
+
+    def _vdra_estimate(self, samples_to_go_deeper, eos_token_id, step):
+        """Batched proxy for every active path of every root at this step."""
+        import time as _time
+        from vdra_core.backend import estimate_batch
+        cfg = self._vdra_cfg()
+        keys, prefixes = [], []
+        for root_node, group in samples_to_go_deeper.items():
+            for path_idx, sample in enumerate(group):
+                keys.append((root_node, path_idx))
+                prefixes.append(list(sample.init_input_ids) + list(sample.full_response_token_ids))
+        t0 = _time.time()
+        backend = self._vdra_backend(eos_token_id)
+        results, _ = estimate_batch(prefixes, backend, cfg)
+        self._vdra_write("vdra_steps", {
+            "step": int(step), "n_nodes": len(prefixes), "seconds": _time.time() - t0,
+            "counters": dict(backend.counters),
+        })
+        out = {}
+        for k, r in zip(keys, results):
+            out[k] = r
+            self._vdra_write("vdra_nodes", {"root": int(k[0]), "path": int(k[1]), "step": int(step), **r.to_row()})
+        return out
+
+    def _vdra_log_queue(self, root_node, step, items, alloc, budget):
+        self._vdra_write("vdra_queues", {
+            "root": int(root_node), "step": int(step), "budget": int(budget),
+            "coefs": [it.coef for it in items], "k_v": [it.k_v for it in items],
+            "capped": [bool(it.capped) for it in items],
+            "n_v": [int(x) for x in alloc],
+        })
+
+    def _vdra_write(self, stream, row):
+        import os
+        log_dir = os.environ.get("VDRA_LOG_DIR", "")
+        if not log_dir:
+            return
+        from vdra_core import JsonlLogger
+        rank = os.environ.get("RANK", "0")
+        JsonlLogger(os.path.join(log_dir, f"{stream}.rank{rank}.jsonl")).write(row)
