+def _load_api_urls(filename: str) -> list[str]:
+    """Load optional legacy API endpoints without requiring a developer path."""
+    candidates = []
+    configured_dir = os.environ.get("TREERL_API_CONFIG_DIR")
+    if configured_dir:
+        candidates.append(os.path.join(configured_dir, filename))
+    repository_config = os.path.abspath(
+        os.path.join(os.path.dirname(__file__), "../../../tools/api_configs", filename)
+    )
+    candidates.extend(
+        [repository_config, f"/workspace/lurui/openrlhf-glm/tools/api_configs/{filename}"]
+    )
+    config_path = next((path for path in candidates if os.path.isfile(path)), None)
+    if config_path is None:
+        return []
+    with open(config_path, encoding="utf-8") as config_file:
+        ips = json.load(config_file).get("ip", {})
+    return [url for url, count in ips.items() for _ in range(count)]
+
+
