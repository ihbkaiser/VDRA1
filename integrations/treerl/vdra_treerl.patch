+    def _vdra_expansion_counts(self, expansion_tasks, init_prompt_ids, T, iteration, problem_str, answer_str):
+        """Return a continuation count per fork (sum = T * len(forks)), or None
+        when VDRA allocation is off (VDRA_TREERL_ALLOC != "vdra")."""
+        import os
+        if os.environ.get("VDRA_TREERL_ALLOC", "") != "vdra" or not expansion_tasks:
+            return None
+        import json as _json
+        import time as _time
+        from vdra_core import VDRAConfig, QueueItem, allocate_queue, partition_into_queues, JsonlLogger
+        from vdra_core.backend import TokenBackend, estimate_batch, from_ray_actor, from_vllm_llm
+        from vdra_core import verifier as _verifier
+
+        cfg_raw = _json.loads(os.environ.get("VDRA_CONFIG_JSON", "{}") or "{}")
+        cfg_raw["reuse_terminal_pilots"] = False   # forks are re-sampled by TreeRL itself
+        cfg = VDRAConfig.from_dict(cfg_raw)
+        if getattr(self, "_vdra_backend", None) is None:
+            eos = [t for t in self.eos_tokens_set if isinstance(t, int)] or None
+            gen = from_ray_actor(self.llm) if hasattr(self.llm, "generate") and hasattr(self.llm.generate, "remote") else from_vllm_llm(self.llm)
+            self._vdra_backend = TokenBackend(
+                generate_fn=gen,
+                temperature=float(self.args.get("temperature", 1.0)),
+                top_p=float(self.args.get("top_p", 1.0)),
+                stop_token_ids=eos,
+                max_model_len=int(os.environ.get("VDRA_MAX_MODEL_LEN", "4096")),
+            )
+        backend = self._vdra_backend
+        prefixes = [list(init_prompt_ids) + list(node.get_prefix_ids(split_idx))
+                    for (_, _, node, split_idx) in expansion_tasks]
+
+        def _terminal_reward(v, pilot_ids):
+            text = self.decode_fn(list(prefixes[v][len(init_prompt_ids):]) + list(pilot_ids))
+            return _verifier.score(text, answer_str, problem_str)
+
+        t0 = _time.time()
+        results, _ = estimate_batch(prefixes, backend, cfg, terminal_reward_fn=_terminal_reward)
+        items = [QueueItem(node_id=f"{tree_idx}/{node_idx}/{split_idx}", coef=r.coef, k_v=r.k_v,
+                           nominal=int(T), capped=r.capped)
+                 for (tree_idx, node_idx, _, split_idx), r in zip(expansion_tasks, results)]
+        counts = []
+        log_dir = os.environ.get("VDRA_LOG_DIR", "")
+        qlog = JsonlLogger(os.path.join(log_dir, f"vdra_queues.pid{os.getpid()}.jsonl") if log_dir else "")
+        for chunk in partition_into_queues(items, cfg.queue_capacity):
+            alloc = allocate_queue(chunk, n_min=cfg.n_min)
+            counts.extend(alloc)
+            qlog.write({"iteration": int(iteration), "budget": int(T) * len(chunk), "n_v": alloc,
+                        "coefs": [it.coef for it in chunk], "k_v": [it.k_v for it in chunk],
+                        "capped": [bool(it.capped) for it in chunk],
+                        "seconds": _time.time() - t0, "counters": dict(backend.counters)})
+        return counts
