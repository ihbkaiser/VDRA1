+
+_REPEAT_PATTERN_HASH_WEIGHTS = np.asarray(
+    [pow(1_000_003, 49 - index, 1 << 64) for index in range(50)], dtype=np.uint64
+)
+
+
+def _has_repeated_patterns_fast(s, pattern_length=50, threshold=20):
+    """Boolean repeated-window check with exact verification for hash hits."""
+    if pattern_length <= 0:
+        return bool(find_repeated_patterns(s, pattern_length, threshold))
+
+    window_count = len(s) - pattern_length + 1
+    if window_count <= 0 or window_count <= threshold:
+        return False
+    if len(s) < 768:
+        return bool(find_repeated_patterns(s, pattern_length, threshold))
+
+    codepoints = np.fromiter(map(ord, s), dtype=np.uint64, count=len(s))
+    windows = np.lib.stride_tricks.sliding_window_view(codepoints, pattern_length)
+    if pattern_length == 50:
+        weights = _REPEAT_PATTERN_HASH_WEIGHTS
+    else:
+        weights = np.asarray(
+            [pow(1_000_003, pattern_length - 1 - index, 1 << 64) for index in range(pattern_length)],
+            dtype=np.uint64,
+        )
+    hashes = windows @ weights
+    unique_hashes, counts = np.unique(hashes, return_counts=True)
+    for hash_value in unique_hashes[counts > threshold]:
+        positions = np.flatnonzero(hashes == hash_value)
+        exact_counts = {}
+        for position in positions:
+            gram = s[int(position) : int(position) + pattern_length]
+            count = exact_counts.get(gram, 0) + 1
+            if count > threshold:
+                return True
+            exact_counts[gram] = count
+    return False
