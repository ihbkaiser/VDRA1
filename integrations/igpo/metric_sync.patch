+        # Pack scalar tensor metrics by dtype so logging performs one collective
+        # and one host synchronization per dtype instead of per metric.
+        tensor_metrics_by_dtype = {}
+        for metric_name, metric_value in accumulated_metrics.items():
+            if (
+                metric_name.startswith("_")
+                and metric_name != "_num_participating_tokens"
+            ):
+                continue
+            if not isinstance(metric_value, torch.Tensor):
+                continue
+            metric_value = metric_value.to(actor.device)
+            tensor_metrics_by_dtype.setdefault(metric_value.dtype, []).append(
+                (metric_name, metric_value.reshape(()))
+            )
+
+        reduced_tensor_metrics = {}
+        for dtype in sorted(tensor_metrics_by_dtype, key=str):
+            named_values = tensor_metrics_by_dtype[dtype]
+            packed_values = torch.stack([value for _, value in named_values])
+            dist.all_reduce(packed_values, op=dist.ReduceOp.SUM)
+            host_values = packed_values.cpu().tolist()
+            reduced_tensor_metrics.update(
+                (name, value)
+                for (name, _), value in zip(named_values, host_values)
+            )
+
+        if "_num_participating_tokens" in reduced_tensor_metrics:
+            num_participating_tokens = reduced_tensor_metrics[
+                "_num_participating_tokens"
+            ]
         else:
