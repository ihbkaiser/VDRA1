+    @staticmethod
+    def _stop_owned_processes(processes):
+        """Terminate captured vLLM descendants without touching other workers."""
+        live_processes = []
+        for process in reversed(processes):
+            try:
+                if process.is_running():
+                    process.terminate()
+                    live_processes.append(process)
+            except psutil.NoSuchProcess:
+                continue
+            except Exception as e:
+                logger.warning(f"Could not terminate owned vLLM PID {process.pid}: {e}")
+
+        _, alive = psutil.wait_procs(live_processes, timeout=3)
+        for process in alive:
+            try:
+                process.kill()
+            except psutil.NoSuchProcess:
+                pass
+            except Exception as e:
+                logger.warning(f"Could not force-kill owned vLLM PID {process.pid}: {e}")
+
+        _, still_alive = psutil.wait_procs(alive, timeout=3)
+        if still_alive:
+            logger.error(
+                "Owned vLLM processes remained after cleanup: "
+                f"{[process.pid for process in still_alive]}"
+            )
+
